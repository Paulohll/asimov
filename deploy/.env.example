# Copy to /opt/asimov/.env on the deployment host and fill in real values.
# This file is a template only — never commit the populated .env.

# Image published by build-docker.sh
DOCKER_IMAGE=europe-west1-docker.pkg.dev/affiliatteaccess/asimov/opencode
DOCKER_TAG=latest

# HTTP basic auth for the legacy single-user `opencode` service on :4000.
# Per-user containers (4001+) sit behind the auth gateway instead and do not use these.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me-strong-password

# Public origin allowed for CORS
CORS_ORIGIN=https://code.euroaffiliati.com

# Provider credentials injected into every user container
GEMINI_API_KEY=
GOOGLE_API_KEY=
